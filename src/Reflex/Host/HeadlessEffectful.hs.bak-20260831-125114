-- | Base effect row for an 'EffectfulHost'. Excludes 'Adjustable' (which
-- has been promoted to the outer 'HeadlessRow' alongside 'PerformEvent'
-- because 'runAdjustable' now requires 'PerformEvent x :> es' to queue
-- sub-widget executions via 'performEventE' — matching upstream
-- 'PerformEventT'\'s two-frame drain semantics).
type BaseEffectfulHostRow (x :: Type) =
  '[ NotReady        (SpiderTimeline x)
   , Sample          (SpiderTimeline x)
   , Hold            (SpiderTimeline x)
   , SubscribeEvent  (SpiderTimeline x)
   , ReadEvent       (SpiderTimeline x)
   , CreateTrigger   (SpiderTimeline x)
   , HostFrame'      (SpiderTimeline x)
   , Timeline        (SpiderTimeline x)
   , IOE
   ]

newtype EffectfulHost (x :: Type) a = EffectfulHost
  { unEffectfulHost :: Eff (BaseEffectfulHostRow x) a
  }
  deriving newtype (Functor, Applicative, Monad, MonadFix)

deriving newtype instance MonadIO (EffectfulHost x)

runEffectfulHostFor
  :: forall x a. HasSpiderTimeline x
  => EffectfulHost x a -> SpiderTimelineEnv x -> IO a
runEffectfulHostFor (EffectfulHost eff) _ =
    runEff
  . runTimeline
  . runHostFrame
  . runCreateTrigger
  . runReadEvent
  . runSubscribeEvent
  . runHold
  . runSample
  . runNotReady
  $ eff

-- | Run an 'EffectfulHost' action affecting the global 'Global' timeline.
--
-- Upstream analog: @runSpiderHost :: SpiderHost Global a -> IO a@.
--
-- The env argument is unused by 'runEffectfulHostFor' — we discharge the
-- effect row directly instead of calling that runner with a placeholder.
runEffectfulHost
  :: forall a. HasSpiderTimeline SI.Global
  => EffectfulHost SI.Global a -> IO a
runEffectfulHost (EffectfulHost eff) =
    runEff
  . runTimeline
  . runHostFrame
  . runCreateTrigger
  . runReadEvent
  . runSubscribeEvent
  . runHold
  . runSample
  . runNotReady
  $ eff

