-- Native PerformEvent effect
--
-- Upstream 'Reflex.PerformEvent.Class.PerformEvent' has associated type
-- 'Performable m'. For our timeline @SpiderTimeline x@, the natural
-- 'Performable' choice is 'SpiderHostFrame x' — matching what upstream
-- 'PerformEventT' picks (@Performable (PerformEventT t m) = HostFrame t
-- = SpiderHostFrame x@).
--
-- The effect delegates to 'Requester': each 'performEvent' is a
-- 'requestingIdentity' call over 'SpiderHostFrame x' requests + 'Identity'
-- responses — mirroring upstream 'PerformEventT's body:
--
--   performEvent_ = PerformEventT . requesting_
--   performEvent  = PerformEventT . requestingIdentity
--------------------------------------------------------------------------------

data PerformEvent (x :: Type) :: Effect where
  PerformEventE_ :: R.Event (SpiderTimeline x) (SI.SpiderHostFrame x ())
                 -> PerformEvent x m ()
  PerformEventE  :: R.Event (SpiderTimeline x) (SI.SpiderHostFrame x a)
                 -> PerformEvent x m (R.Event (SpiderTimeline x) a)
type instance E.DispatchOf (PerformEvent x) = E.Dynamic

performEventE_ :: forall x es. (PerformEvent x :> es)
               => R.Event (SpiderTimeline x) (SI.SpiderHostFrame x ()) -> Eff es ()
performEventE_ = send @(PerformEvent x) . PerformEventE_

performEventE :: forall x es a. (PerformEvent x :> es)
              => R.Event (SpiderTimeline x) (SI.SpiderHostFrame x a)
              -> Eff es (R.Event (SpiderTimeline x) a)
performEventE = send @(PerformEvent x) . PerformEventE

-- | Native PerformEvent interpreter. Reinterprets 'PerformEvent' as
-- 'Requester (SpiderTimeline x) (SpiderHostFrame x) Identity', then
-- discharges Requester using 'runRequester'.
--
-- Returns @(result, aggregatedActions)@ — the second component is an
-- 'Event' that fires with a 'RequesterData (SpiderHostFrame x)' bundle
-- whenever any 'performEvent'-scheduled action needs to run. The
-- 'runHeadlessApp' loop subscribes to this event, runs each action in
-- a host-frame, and fires the response trigger to notify downstream
-- 'requesting' calls.
runPerformEvent
  :: forall x es a. (HasSpiderTimeline x, R.Reflex (SpiderTimeline x), IOE :> es)
  => R.Event (SpiderTimeline x) (RequesterData Identity)
  -> Eff (PerformEvent x : es) a
  -> Eff es (a, R.Event (SpiderTimeline x) (RequesterData (SI.SpiderHostFrame x)))
runPerformEvent responses act =
  reinterpret
    (runRequester @x @(SI.SpiderHostFrame x) @Identity responses)
    (\_ -> \case
        PerformEventE_ ev ->
          requestingE_ @(SpiderTimeline x) @(SI.SpiderHostFrame x) @Identity ev
        PerformEventE ev ->
          requestingIdentityE @(SpiderTimeline x) @(SI.SpiderHostFrame x) ev)
    act

-- | Reinterpret 'PerformEvent x' by routing to the outer 'Requester' scope
-- already present in the row. Companion to 'runRequester' when Requester
-- is discharged separately at the OUTER layer (needed by 'runAdjustableInRequesterT'
-- which requires 'Requester :> es' in its handler's row).
--
-- Composition pattern used by 'hostPerformEventT' after Task #122 fix:
--   'runRequester responses . interpretPerformEventAsRequester . runAdjustable . runAdjustableInRequesterT $ act'
-- vs the older 'runPerformEvent . runAdjustable $ act' which discharged
-- Requester transiently and didn't expose it to Adjustable's handler.
interpretPerformEventAsRequester
  :: forall x es a.
     ( HasSpiderTimeline x
     , R.Reflex (SpiderTimeline x)
     , Requester (SpiderTimeline x) (SI.SpiderHostFrame x) Identity :> es
     )
  => Eff (PerformEvent x : es) a -> Eff es a
interpretPerformEventAsRequester = interpret $ \_ -> \case
  PerformEventE_ ev ->
    requestingE_ @(SpiderTimeline x) @(SI.SpiderHostFrame x) @Identity ev
  PerformEventE ev ->
    requestingIdentityE @(SpiderTimeline x) @(SI.SpiderHostFrame x) ev

