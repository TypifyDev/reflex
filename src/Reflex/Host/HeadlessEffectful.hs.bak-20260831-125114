-- Interpreters for the base row
--------------------------------------------------------------------------------

runSample
  :: forall x es a. (HasSpiderTimeline x, IOE :> es)
  => Eff (Sample (SpiderTimeline x) : es) a -> Eff es a
runSample = interpret $ \_ -> \case
  Sample b -> liftIO $ frame @x (readBehaviorUntracked (SI.unSpiderBehavior b))

-- | 'Hold' interpreter. Uses 'runEventM' rather than 'frame @x' — 'frame'
-- calls 'runHoldInits' at the end of each invocation, which SUBSCRIBES to
-- all scheduled hold events. Under 'MonadFix'-recursive @rec@/@mdo@
-- blocks (e.g. 'Reflex.Requester.Base.matchResponseMapWithRequests' at
-- line 573), subscribing during the @mfix@ body forces the recursive
-- value before it's computed and throws @cyclic evaluation in fixIO@.
--
-- 'SI.hold' itself only 'defer's a 'SomeHoldInit' onto the shared env's
-- init queue (see 'Reflex.Spider.Internal.hold' at line 989). Actual
-- subscription happens later when SOME 'frame'-call runs 'runHoldInits'.
-- All our 'frame' call-sites downstream (e.g. 'runE' via
-- 'fireEventsAndRead', 'runAdjustable' via 'subscribe', etc.) still call
-- 'runHoldInits', so pending inits get processed on the first frame
-- boundary — matching upstream 'PerformEventT'\'s behavior where
-- 'runHostFrame' processes all in-batch holds at once at the end of
-- 'unPerformEventT'.
runHold
  :: forall x es a. (HasSpiderTimeline x, IOE :> es)
  => Eff (Hold (SpiderTimeline x) : es) a -> Eff es a
runHold = interpret $ \_ -> \case
  Hold v0 e -> liftIO $ runEventM $
    (fmap (SI.SpiderBehavior . behaviorHoldIdentity) $
      SI.hold v0 (coerce (SI.unSpiderEvent e))
      :: EventM x _)
  HoldDynE v0 e -> liftIO $ runEventM $
    (fmap (SI.SpiderDynamic . dynamicHoldIdentity) $
      SI.hold v0 (coerce (SI.unSpiderEvent e))
      :: EventM x _)
  HoldIncrementalE v0 e -> liftIO $ runEventM $
    (fmap (SI.SpiderIncremental . dynamicHold) $
      SI.hold v0 (SI.unSpiderEvent e)
      :: EventM x _)
  BuildDynamicE getV0 e -> liftIO $ runEventM $
    (fmap (SI.SpiderDynamic . dynamicDynIdentity) $
      SI.buildDynamic (coerce getV0) (coerce (SI.unSpiderEvent e))
      :: EventM x _)
  -- Native port of 'Reflex.Class.slowHeadE':
  --   rec be <- hold e $ fmapCheap (const never) e'
  --       let e' = switch be
  -- Bypasses the class-level MonadHold recursion by using Spider primitives.
  HeadEE e -> liftIO $ runEventM (slowHeadEBody @x (SI.unSpiderEvent e))
  NowE -> liftIO $ runEventM (fmap SI.SpiderEvent (SI.now :: EventM x _))

-- | Native re-implementation of upstream 'Reflex.Class.slowHeadE' using
-- Spider primitives. Split out from 'runHold's 'HeadEE' branch so the
-- event's payload type is a properly-scoped top-level type variable
-- rather than a GADT existential (which can't be annotated in a
-- pattern binding).
slowHeadEBody :: forall x a. HasSpiderTimeline x
              => SI.Event x a -> EventM x (R.Event (SpiderTimeline x) a)
slowHeadEBody ev = mdo
  let quench :: SI.Event x (Identity (SI.Event x a))
      quench = coerce
        (SI.pushCheap (\_ -> pure (Just (SI.eventNever :: SI.Event x a))) e')
  h <- SI.hold ev quench
  let be = SI.behaviorHoldIdentity h
      e' = SI.switch be
  pure (SI.SpiderEvent e')

runNotReady :: forall t es a. Eff (NotReady t : es) a -> Eff es a
runNotReady = interpret $ \_ -> \case
  NotReady        -> pure ()
  NotReadyUntil _ -> pure ()

runSubscribeEvent
  :: forall x es a. (HasSpiderTimeline x, IOE :> es)
  => Eff (SubscribeEvent (SpiderTimeline x) : es) a -> Eff es a
runSubscribeEvent = interpret $ \_ -> \case
  SubscribeEventOp e -> liftIO $ frame $ do
    val <- liftIO (newIORef Nothing)
    subscription <- subscribe (SI.unSpiderEvent e) $ Subscriber
      { subscriberPropagate = \a -> do
          liftIO (writeIORef val (Just a))
          scheduleClear val
      , subscriberInvalidateHeight = \_ -> pure ()
      , subscriberRecalculateHeight = \_ -> pure ()
      }
    pure $ SpiderEventHandle
      { spiderEventHandleSubscription = subscription
      , spiderEventHandleValue = val
      }

runReadEvent
  :: forall x es a. (HasSpiderTimeline x, IOE :> es)
  => Eff (ReadEvent (SpiderTimeline x) : es) a -> Eff es a
runReadEvent = interpret $ \_ -> \case
  ReadEventOp h -> do
    result <- liftIO (readIORef (spiderEventHandleValue h))
    pure (fmap pure result)

runCreateTrigger
  :: forall x es a. (HasSpiderTimeline x, IOE :> es)
  => Eff (CreateTrigger (SpiderTimeline x) : es) a -> Eff es a
runCreateTrigger = interpret $ \_ -> \case
  NewEventWithTrigger f -> liftIO $ SI.SpiderEvent <$> newEventWithTriggerIO f
  NewFanEventWithTrigger f -> liftIO $ do
    es <- newFanEventWithTriggerIO f
    pure $ EventSelector $ SI.SpiderEvent . SI.select es

runHostFrame
  :: forall x es a. (HasSpiderTimeline x, IOE :> es)
  => Eff (HostFrame' (SpiderTimeline x) : es) a -> Eff es a
runHostFrame = interpret $ \_ -> \case
  FireEventsAndRead evs (ReadPhase a) -> liftIO (runE evs a)
  RunHostFrame hf -> liftIO $ frame (SI.runSpiderHostFrame hf)

-- | Native 'Adjustable' interpreter.
--
-- Matches upstream 'PerformEventT'\'s two-frame drain semantics AND
-- supports arbitrarily-nested @runWithReplace@ from sub-widgets (e.g.
-- via 'Reflex.Network.networkHold'), via this two-stage design:
--
-- (1) Sub-widget action runs INLINE during propagation via 'SI.pushCheap'
--     using a 'SeqForkUnlift'-provided unlift (persistent past the
--     callback, forks env per call so nested Adjustable dispatches don't
--     bump storage versions of the outer captured env). Sub-widget's
--     Reflex-primitive registrations (holds, subscribes, requestingE)
--     happen in the current frame, matching upstream. The result is
--     stashed in an 'IORef'.
--
-- (2) An empty output-trigger event is fired at stage 1 (unit). A
--     'performEventE' action queued on that trigger reads the stashed
--     'IORef' at DRAIN TIME, one frame later — matching upstream where
--     'runWithReplaceRequesterTWith'\'s @requestingIdentity@ makes the
--     replacement value observable in a follow-up frame.
--
-- The drain-time reader is a pure IO computation (no Eff env
-- involvement); the only cross-frame data flow is the IORef. Sub-widget
-- request registrations (via 'requestingE' inside the sub-widget) are
-- captured in the outer 'Requester' scope because that scope uses IORef
-- state (not Effectful.State), which is shared across 'SeqForkUnlift'
-- forks.
--
-- Requires @PerformEvent x :> es@ to enqueue the drain-time reader.
runAdjustable
  :: forall x es a. ( HasSpiderTimeline x
                    , IOE :> es
                    , PerformEvent x :> es
                    )
  => Eff (Adjustable (SpiderTimeline x) : es) a -> Eff es a
runAdjustable = interpret $ \env -> \case
  RunWithReplace a0 a' -> do
    (x0, triggerEv, resultRef) <- localUnliftIO env SeqForkUnlift $ \unlift -> do
      x0 <- unlift a0
      ref <- newIORef Nothing
      let triggerEv = SI.SpiderEvent $ SI.pushCheap
            (\newAction -> do
                val <- liftIO (unlift newAction)
                liftIO (writeIORef ref (Just val))
                pure (Just ()))
            (SI.unSpiderEvent a')
      pure (x0, triggerEv, ref)
    outEv <- performEventE @x $ R.fmapCheap
      (\() -> SI.SpiderHostFrame $ SI.EventM $ do
          mval <- readIORef resultRef
          writeIORef resultRef Nothing
          case mval of
            Just val -> pure val
            Nothing  -> error "runAdjustable/RunWithReplace: result IORef empty at drain (impossible)")
      triggerEv
    pure (x0, outEv)
  TraverseIntMapWithKeyWithAdjustOp f m0 pev -> do
    (m0', triggerEv, resultRef) <- localUnliftIO env SeqForkUnlift $ \unlift -> do
      m0' <- IntMap.traverseWithKey (\k v -> unlift (f k v)) m0
      ref <- newIORef Nothing
      let triggerEv = SI.SpiderEvent $ SI.pushCheap
            (\(PatchIntMap patch) -> do
                newInner <- liftIO $ IntMap.traverseWithKey
                  (\k mv -> traverse (unlift . f k) mv)
                  patch
                liftIO (writeIORef ref (Just (PatchIntMap newInner)))
                pure (Just ()))
            (SI.unSpiderEvent pev)
      pure (m0', triggerEv, ref)
    outEv <- performEventE @x $ R.fmapCheap
      (\() -> SI.SpiderHostFrame $ SI.EventM $ do
          mval <- readIORef resultRef
          writeIORef resultRef Nothing
          case mval of
            Just val -> pure val
            Nothing  -> error "runAdjustable/TraverseIntMap: result IORef empty at drain (impossible)")
      triggerEv
    pure (m0', outEv)
  TraverseDMapWithKeyWithAdjustOp f m0 pev -> do
    (m0', triggerEv, resultRef) <- localUnliftIO env SeqForkUnlift $ \unlift -> do
      m0' <- DMap.traverseWithKey (\k v -> unlift (f k v)) m0
      ref <- newIORef Nothing
      let triggerEv = SI.SpiderEvent $ SI.pushCheap
            (\(PatchDMap patch) -> do
                newInner <- liftIO $ DMap.traverseWithKey
                  (\k (ComposeMaybe mv) ->
                      ComposeMaybe <$> traverse (unlift . f k) mv)
                  patch
                liftIO (writeIORef ref (Just (PatchDMap newInner)))
                pure (Just ()))
            (SI.unSpiderEvent pev)
      pure (m0', triggerEv, ref)
    outEv <- performEventE @x $ R.fmapCheap
      (\() -> SI.SpiderHostFrame $ SI.EventM $ do
          mval <- readIORef resultRef
          writeIORef resultRef Nothing
          case mval of
            Just val -> pure val
            Nothing  -> error "runAdjustable/TraverseDMap: result IORef empty at drain (impossible)")
      triggerEv
    pure (m0', outEv)
  TraverseDMapWithKeyWithAdjustWithMoveOp f m0 pev -> do
    (m0', triggerEv, resultRef) <- localUnliftIO env SeqForkUnlift $ \unlift -> do
      m0' <- DMap.traverseWithKey (\k v -> unlift (f k v)) m0
      ref <- newIORef Nothing
      let triggerEv = SI.SpiderEvent $ SI.pushCheap
            (\(PatchDMapWithMove patch) -> do
                newInner <- liftIO $ DMap.traverseWithKey
                  (\k node -> do
                      newFrom <- case _nodeInfo_from node of
                        From_Insert v -> From_Insert <$> unlift (f k v)
                        From_Delete   -> pure From_Delete
                        From_Move src -> pure (From_Move src)
                      pure NodeInfo
                        { _nodeInfo_from = newFrom
                        , _nodeInfo_to   = _nodeInfo_to node
                        })
                  patch
                liftIO (writeIORef ref (Just (PatchDMapWithMove newInner)))
                pure (Just ()))
            (SI.unSpiderEvent pev)
      pure (m0', triggerEv, ref)
    outEv <- performEventE @x $ R.fmapCheap
      (\() -> SI.SpiderHostFrame $ SI.EventM $ do
          mval <- readIORef resultRef
          writeIORef resultRef Nothing
          case mval of
            Just val -> pure val
            Nothing  -> error "runAdjustable/TraverseDMapWithMove: result IORef empty at drain (impossible)")
      triggerEv
    pure (m0', outEv)

