data PostBuild (t :: Type) :: Effect where
  GetPostBuild :: PostBuild t m (R.Event t ())
type instance E.DispatchOf (PostBuild t) = E.Dynamic
getPostBuildE :: PostBuild t :> es => Eff es (R.Event t ())
getPostBuildE = send GetPostBuild

runPostBuild
  :: forall t es a. R.Event t () -> Eff (PostBuild t : es) a -> Eff es a
runPostBuild ev = interpret $ \_ -> \case
  GetPostBuild -> pure ev

