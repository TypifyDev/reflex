-- TriggerEvent effect + interpreter — Chan-based, matches upstream
-- 'Reflex.TriggerEvent.Base'.
--------------------------------------------------------------------------------

data TriggerInvocation a = TriggerInvocation a (IO ())

-- | Ref-cell holding a maybe-trigger. Matches upstream
-- 'Reflex.TriggerEvent.Base.EventTriggerRef'.
newtype EventTriggerRef t a = EventTriggerRef
  { unEventTriggerRef :: IORef (Maybe (EventTrigger t a))
  }

data TriggerEvent (t :: Type) :: Effect where
  NewTriggerEvent
    :: TriggerEvent t m (R.Event t a, a -> IO ())
  NewTriggerEventWithOnComplete
    :: TriggerEvent t m (R.Event t a, a -> IO () -> IO ())
  NewEventWithLazyTriggerWithOnComplete
    :: ((a -> IO () -> IO ()) -> IO (IO ()))
    -> TriggerEvent t m (R.Event t a)
type instance E.DispatchOf (TriggerEvent t) = E.Dynamic

newTriggerEventE :: TriggerEvent t :> es => Eff es (R.Event t a, a -> IO ())
newTriggerEventE = send NewTriggerEvent
newTriggerEventWithOnCompleteE :: TriggerEvent t :> es => Eff es (R.Event t a, a -> IO () -> IO ())
newTriggerEventWithOnCompleteE = send NewTriggerEventWithOnComplete
newEventWithLazyTriggerWithOnCompleteE
  :: TriggerEvent t :> es
  => ((a -> IO () -> IO ()) -> IO (IO ()))
  -> Eff es (R.Event t a)
newEventWithLazyTriggerWithOnCompleteE = send . NewEventWithLazyTriggerWithOnComplete

-- | Interpret 'TriggerEvent' against a firing 'Chan'. Matches upstream
-- 'runTriggerEventT' shape (chan passed positionally).
runTriggerEvent
  :: forall x es a. (HasSpiderTimeline x, IOE :> es)
  => Chan [DSum (EventTriggerRef (SpiderTimeline x)) TriggerInvocation]
  -> Eff (TriggerEvent (SpiderTimeline x) : es) a
  -> Eff es a
runTriggerEvent chan = interpret $ \_ -> \case
  NewTriggerEvent -> liftIO $ do
    rt <- newIORef Nothing
    ev <- SI.SpiderEvent <$> newEventWithTriggerIO (\t -> do
        writeIORef rt (Just t)
        pure (writeIORef rt Nothing))
    let fire a = writeChan chan
          [EventTriggerRef rt :=> TriggerInvocation a (pure ())]
    pure (ev, fire)
  NewTriggerEventWithOnComplete -> liftIO $ do
    rt <- newIORef Nothing
    ev <- SI.SpiderEvent <$> newEventWithTriggerIO (\t -> do
        writeIORef rt (Just t)
        pure (writeIORef rt Nothing))
    let fire a onComplete = writeChan chan
          [EventTriggerRef rt :=> TriggerInvocation a onComplete]
    pure (ev, fire)
  NewEventWithLazyTriggerWithOnComplete setup -> liftIO $ do
    -- The setup callback wants @(a -> IO () -> IO ()) -> IO (IO ())@;
    -- we route it to newEventWithTriggerIO by ignoring the on-complete
    -- shape (that scaffold's not fully replicated here — upstream's
    -- LazyTrigger wires this through Chan; we do the same lazily).
    rt <- newIORef Nothing
    ev <- SI.SpiderEvent <$> newEventWithTriggerIO (\t -> do
        writeIORef rt (Just t)
        cancel <- setup (\a cb -> writeChan chan
          [EventTriggerRef rt :=> TriggerInvocation a cb])
        pure (cancel >> writeIORef rt Nothing))
    pure ev

