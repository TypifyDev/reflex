        eventMap0 <- liftIO $ readIORef initialAgg
        (patchEv, firePatch) <- liftIO $ do
          rt <- newIORef Nothing
          ev <- SI.SpiderEvent <$> newEventWithTriggerIO (\t -> do
            writeIORef rt (Just t)
