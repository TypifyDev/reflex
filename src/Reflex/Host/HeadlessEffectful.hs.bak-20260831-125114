-- Query effect + interpreter — port of MTL 'Reflex.Query.Base' + the
-- MonadQuery method bodies from 'Reflex.Query.Class'.
--
-- Upstream references (verbatim MTL source lives in this same package
-- under @Reflex.Query.Base@ / @Reflex.Query.Class@):
--
--   newtype QueryT t q m a = QueryT
--     { unQueryT :: StateT [Behavior t q]
--                     (EventWriterT t q
--                        (ReaderT (Dynamic t (QueryResult q)) m)) a }
--
-- In the port, the three transformer layers collapse into ONE Query
-- effect + interpreter that owns:
--
--   * IORef [Behavior t q]        — StateT analog (collector of behaviors)
--   * IORef [Event t q]           — EventWriterT analog (patch log)
--   * Dynamic t (QueryResult q)   — ReaderT env (parameter to interpreter)
--
-- Method-body ports (per 'Reflex.Query.Class.MonadQuery' at line 138):
--
--   MTL:  tellQueryIncremental q =
--           QueryT (modify (currentIncremental q:))
--           QueryT (lift (tellEvent (fmapCheap unAdditivePatch (updatedIncremental q))))
--   Eff:  TellQueryIncremental inc -> ...
--           modifyIORef' behaviorsRef (currentIncremental inc :)
--           modifyIORef' eventsRef    (fmapCheap unAdditivePatch (updatedIncremental inc) :)
--
--   MTL:  askQueryResult = QueryT ask
--   Eff:  AskQueryResult -> pure responseDyn
--
--   MTL:  queryIncremental q =
--           tellQueryIncremental q
--           zipDynWith crop (incrementalToDynamic q) <$> askQueryResult
--   Eff:  QueryIncremental inc -> ...
--           tell behaviors + events
--           pure (zipDynWith crop (incrementalToDynamic inc) responseDyn)
--
-- TODO(2026-08-30): Adjustable-cross behavior.
--
-- The MTL @instance Adjustable t (QueryT t q m)@ intercepts
-- 'runWithReplace' and 'traverse*WithKeyWithAdjust' at the class level to
-- give sub-widget scopes their own query-collection state, then bubble
-- the sub-scope's aggregate query up to the parent as an 'AdditivePatch q'.
-- This is what makes @QueryT@ compose correctly with @runWithReplace@ —
-- deleted sub-widgets have their queries subtracted, added ones have
-- theirs added, all via 'AdditivePatch'.
--
-- The Effectful port does NOT yet cover this. Two viable paths:
--
--   (a) 'interpose' Adjustable inside 'runQueryE' so that when a child
--       widget calls 'runWithReplace' etc., the Query interpreter sees
--       it and installs a fresh per-cohort behavior collector — much like
--       'runAdjustableInRequesterT' installs per-cohort Requester state.
--       Complexity is similar; carrier is the same 'localUnliftIO' +
--       IORef swap pattern.
--
--   (b) Grow the fused runner ('runPerformEventAndAdjustable') into a
--       four-effect fused runner that owns Query state alongside the
--       Adjustable / PerformEvent / Requester triple. Cleaner because it
--       shares the cohort pointer already there; costly because it churns
--       an already-load-bearing interpreter.
--
-- Neither is landed here. Consumers of this port using @runWithReplace@
-- inside a @Query@ scope get a Query interpreter that doesn't reset per
-- cohort — behaviors from deleted sub-widgets remain in the aggregate.
-- Real usage inside 'Rhyolite.Frontend.App.RhyoliteWidget' will require
-- path (a) or (b) to land before we can retire the MTL 'QueryT'.
--------------------------------------------------------------------------------

-- | Semantic type alias — the query interpreter's behavior collector.
-- Mirrors the MTL @StateT [Behavior t w] m@ inner layer of @QueryT@. In
-- Effectful, the same shape is 'EFST.State [Behavior t w]' — but naming
-- it 'BehaviorWriter' at the row level keeps the semantic intent legible
-- to consumers and mirrors the class name 'Reflex.BehaviorWriter.Class.BehaviorWriter'.
type BehaviorWriter (t :: Type) (w :: Type) = EFST.State [R.Behavior t w]

-- | Semantic type alias — the query interpreter's event-writer log.
-- Mirrors the MTL @EventWriterT t w m@ layer. In Effectful, we hold a
-- @[Event t w]@ in state and merge with '(<>)' at drain time; upstream
-- @EventWriterT@ does the same accumulation via its 'tellEvent' but via
-- @StateT@ over @EventWriterState@ under the hood.
type EventWriter (t :: Type) (w :: Type) = EFST.State [R.Event t w]

-- | 'tellBehavior' analog for the effectful 'BehaviorWriter'. Prepends
-- the given behavior to the accumulator.
tellBehaviorE
  :: forall t w es. (BehaviorWriter t w :> es)
  => R.Behavior t w -> Eff es ()
tellBehaviorE b = EFST.modify @[R.Behavior t w] (b :)

-- | 'tellEvent' analog for the effectful 'EventWriter'. Prepends the
-- given event to the accumulator; the aggregate is merged at drain time
-- inside 'runQueryE'.
tellEventE
  :: forall t w es. (EventWriter t w :> es)
  => R.Event t w -> Eff es ()
tellEventE e = EFST.modify @[R.Event t w] (e :)

-- | Query effect — Effectful analog of the MTL 'MonadQuery' class method
-- surface. Three constructors mirror the class methods verbatim.
data Query (t :: Type) (q :: Type) :: Effect where
  TellQueryIncremental
    :: R.Incremental t (AdditivePatch q)
    -> Query t q m ()
  AskQueryResult
    :: Query t q m (R.Dynamic t (RQuery.QueryResult q))
  QueryIncremental
    :: R.Incremental t (AdditivePatch q)
    -> Query t q m (R.Dynamic t (RQuery.QueryResult q))
type instance E.DispatchOf (Query t q) = E.Dynamic

-- | Send helper — analog of 'Reflex.Query.Class.tellQueryIncremental'.
tellQueryIncrementalE
  :: forall t q es. (Query t q :> es)
  => R.Incremental t (AdditivePatch q) -> Eff es ()
tellQueryIncrementalE = send @(Query t q) . TellQueryIncremental

-- | Send helper — analog of 'Reflex.Query.Class.askQueryResult'.
askQueryResultE
  :: forall t q es. (Query t q :> es)
  => Eff es (R.Dynamic t (RQuery.QueryResult q))
askQueryResultE = send @(Query t q) AskQueryResult

-- | Send helper — analog of 'Reflex.Query.Class.queryIncremental'.
queryIncrementalE
  :: forall t q es. (Query t q :> es)
  => R.Incremental t (AdditivePatch q)
  -> Eff es (R.Dynamic t (RQuery.QueryResult q))
queryIncrementalE = send @(Query t q) . QueryIncremental

-- | Eff-shape port of 'Reflex.Query.Class.tellQueryDyn' — turns a Dynamic
-- of queries into an Incremental with additive-patch semantics, then
-- 'tellQueryIncremental's it.
--
-- MTL body (verbatim from Reflex.Query.Class):
--
-- > tellQueryDyn d =
-- >   tellQueryIncremental $ unsafeBuildIncremental
-- >     (sample (current d))
-- >     (attachWith (\old new -> AdditivePatch (new ~~ old)) (current d) (updated d))
tellQueryDynE
  :: forall t q es.
     ( R.Reflex t, Query t q :> es
     , Group q, Commutative q, RQuery.Query q
     )
  => R.Dynamic t q -> Eff es ()
tellQueryDynE d =
  tellQueryIncrementalE @t @q $ R.unsafeBuildIncremental
    (R.sample (R.current d))
    (R.attachWith (\old new -> AdditivePatch (new ~~ old))
                  (R.current d) (R.updated d))

-- | Eff-shape port of 'Reflex.Query.Class.queryDyn'. MTL body:
--
-- > queryDyn q = tellQueryDyn q >> zipDynWith crop q <$> askQueryResult
queryDynE
  :: forall t q es.
     ( R.Reflex t, Query t q :> es
     , Group q, Commutative q, RQuery.Query q
     )
  => R.Dynamic t q -> Eff es (R.Dynamic t (RQuery.QueryResult q))
queryDynE d = do
  tellQueryDynE @t @q d
  r <- askQueryResultE @t @q
  pure (R.zipDynWith RQuery.crop d r)

-- | Eff-shape port of 'Reflex.Query.Class.subQuery'. MTL body:
--
-- > subQuery m d = fmap (mapQueryResult m) <$> queryDyn (mapQuery m <$> d)
subQueryE
  :: forall t q1 q2 es.
     ( R.Reflex t, Query t q2 :> es
     , Group q2, Commutative q2, RQuery.Query q2
     )
  => QueryMorphism q1 q2 -> R.Dynamic t q1 -> Eff es (R.Dynamic t (RQuery.QueryResult q1))
subQueryE morphism d =
  fmap (RQuery.mapQueryResult morphism) <$>
    queryDynE @t @q2 (fmap (RQuery.mapQuery morphism) d)

-- | Interpret 'Query' by supplying the response Dynamic — analog of
-- MTL @runQueryT@ ('Reflex.Query.Base' line 74):
--
-- > runQueryT (QueryT a) qr = do
-- >   ((r, bs), es) <- runReaderT (runEventWriterT (runStateT a mempty)) qr
-- >   return
-- >     ( r
-- >     , unsafeBuildIncremental
-- >         (foldlM (\\b c -> (b <>) <$> sample c) mempty bs)
-- >         (fmapCheap AdditivePatch es)
-- >     )
--
-- Returns @(result, aggregate incremental of the child's queries)@ in
-- the same shape the MTL version returns.
--
-- Pinned to @SpiderTimeline x@ because the aggregate incremental
-- 'R.unsafeBuildIncremental' + 'R.mergeWith' calls are Spider-timeline
-- specific in this package. See 'runRequester' for the same pattern.
--
-- KNOWN INCOMPLETENESS: does not yet cover per-cohort behavior collection
-- under 'runWithReplace' / 'traverseIntMapWithKeyWithAdjust' / etc.
-- See the TODO block above for the two viable landing paths.
runQueryE
  :: forall x q es a.
     ( HasSpiderTimeline x
     , R.Reflex (SpiderTimeline x)
     , IOE :> es
     , Sample (SpiderTimeline x) :> es
     , Hold (SpiderTimeline x) :> es
     , RQuery.Query q
     , Commutative q, Group q, Monoid q, Semigroup q
     )
  => R.Dynamic (SpiderTimeline x) (RQuery.QueryResult q)
  -> Eff (Query (SpiderTimeline x) q : es) a
  -> Eff es (a, R.Incremental (SpiderTimeline x) (AdditivePatch q))
runQueryE responseDyn act = do
  -- Two-layer state discharge — mirrors the MTL @StateT [Behavior]
  -- (EventWriterT t q ...)@ shape as two peer Effectful 'State' cells.
  -- 'reinterpret' installs 'BehaviorWriter' + 'EventWriter' as the
  -- inner row that the Query effect's handler writes into; the two
  -- 'EFST.runState' calls in the runner argument drain them at the end.
  --
  -- The final tuple @((result, bs), es_)@ mirrors MTL's
  -- @((r, bs), es) <- runReaderT (runEventWriterT (runStateT a mempty)) qr@.
  ((result, bs), es_) <- reinterpret
    ( EFST.runState @[R.Event    (SpiderTimeline x) q] []
    . EFST.runState @[R.Behavior (SpiderTimeline x) q] []
    )
    (\_env -> \case
        TellQueryIncremental inc -> do
          -- MTL:
          --   QueryT (modify (currentIncremental q:))
          --   QueryT (lift (tellEvent (fmapCheap unAdditivePatch (updatedIncremental q))))
          tellBehaviorE @(SpiderTimeline x) @q (R.currentIncremental inc)
          tellEventE    @(SpiderTimeline x) @q
            (R.fmapCheap unAdditivePatch (R.updatedIncremental inc))
        AskQueryResult ->
          -- MTL: QueryT ask
          pure responseDyn
        QueryIncremental inc -> do
          -- MTL:
          --   tellQueryIncremental q
          --   zipDynWith crop (incrementalToDynamic q) <$> askQueryResult
          tellBehaviorE @(SpiderTimeline x) @q (R.currentIncremental inc)
          tellEventE    @(SpiderTimeline x) @q
            (R.fmapCheap unAdditivePatch (R.updatedIncremental inc))
          pure (R.zipDynWith RQuery.crop (R.incrementalToDynamic inc) responseDyn)
    )
    act
  -- Build aggregate incremental from collected state — MTL runQueryT tail:
  --   unsafeBuildIncremental
  --     (foldlM (\b c -> (b <>) <$> sample c) mempty bs)
  --     (fmapCheap AdditivePatch es)
  --
  -- MTL's EventWriterT tell accumulates via '<>'; we merged into a list
  -- and reduce with 'mergeWith (<>)' here to match that reduction.
  let mergedEv = R.mergeWith (<>) es_
      aggIncr  = R.unsafeBuildIncremental
                   (foldlM (\b c -> (b <>) <$> R.sample c) mempty bs)
                   (R.fmapCheap AdditivePatch mergedEv)
  pure (result, aggIncr)

-- | Eff-shape port of MTL 'Reflex.Query.Base.withQueryT'. Runs an inner
-- action in a mapped query type by supplying a 'QueryMorphism'.
--
-- MTL body:
--
-- > withQueryT f a = do
-- >   r' <- askQueryResult
-- >   (result, q) <- lift $ runQueryT a $ mapQueryResult f <$> r'
-- >   tellQueryIncremental $ unsafeBuildIncremental
-- >     (fmap (mapQuery f) (sample (currentIncremental q)))
-- >     (fmapCheap (AdditivePatch . mapQuery f . unAdditivePatch) $ updatedIncremental q)
-- >   return result
--
-- The Eff form takes the inner action as an @Eff@ with @Query t q@ in
-- its row and produces an @Eff@ that requires only @Query t q'@ — the
-- mapping direction matches MTL @QueryT t q m a -> QueryT t q' m a@.
withQueryE
  :: forall x q q' es a.
     ( HasSpiderTimeline x
     , R.Reflex (SpiderTimeline x)
     , IOE :> es
     , Sample (SpiderTimeline x) :> es
     , Hold (SpiderTimeline x) :> es
     , Query (SpiderTimeline x) q' :> es
     , Group q, Group q', Commutative q, Commutative q'
     , Monoid q, Semigroup q
     , RQuery.Query q, RQuery.Query q'
     )
  => QueryMorphism q q'
  -> Eff (Query (SpiderTimeline x) q : es) a
  -> Eff es a
withQueryE f inner = do
  r' <- askQueryResultE @(SpiderTimeline x) @q'
  (result, q) <- runQueryE @x @q
                   (fmap (RQuery.mapQueryResult f) r')
                   inner
  tellQueryIncrementalE @(SpiderTimeline x) @q' $ R.unsafeBuildIncremental
    (fmap (RQuery.mapQuery f) (R.sample (R.currentIncremental q)))
    (R.fmapCheap (AdditivePatch . RQuery.mapQuery f . unAdditivePatch)
                 (R.updatedIncremental q))
  pure result

-- | Eff-shape port of MTL 'Reflex.Query.Base.mapQueryT'. In the MTL
-- world this maps a function over the underlying monad; in Effectful,
-- the underlying "monad" is the effect row, and mapping across rows is
-- inherent to 'reinterpret' / 'raise' — this helper is provided for
-- API-shape parity but does no work beyond identity.
--
-- If you need to relocate an Eff action to a different row, use
-- Effectful's 'raise' / 'reinterpret' directly.
mapQueryE
  :: forall t q es a. Eff (Query t q : es) a -> Eff (Query t q : es) a
mapQueryE = id
{-# INLINE mapQueryE #-}

-- | Eff-shape port of MTL 'Reflex.Query.Base.dynWithQueryT'. Runs an
-- inner action with a Dynamic 'QueryMorphism' — the morphism can change
-- over time.
--
-- MTL body (line 262):
--
-- > dynWithQueryT f q = do
-- >   r' <- askQueryResult
-- >   (result, q') <- lift $ runQueryT q $ zipDynWith mapQueryResult f r'
-- >   tellQueryIncremental $ zipDynIncrementalWith mapQuery f q'
-- >   return result
-- >  where zipDynIncrementalWith g da ib =
-- >          let eab = align (updated da) (updatedIncremental ib)
-- >              ec = flip push eab $ \\case
-- >                  This a -> ...
-- >                  That (AdditivePatch b) -> ...
-- >                  These a (AdditivePatch b) -> ...
-- >          in unsafeBuildIncremental (g <$> sample (current da) <*> sample (currentIncremental ib)) ec
--
-- The @zipDynIncrementalWith@ local helper is inlined here verbatim in
-- shape.
dynWithQueryE
  :: forall x q q' es a.
     ( HasSpiderTimeline x
     , R.Reflex (SpiderTimeline x)
     , IOE :> es
     , Sample (SpiderTimeline x) :> es
     , Hold (SpiderTimeline x) :> es
     , Query (SpiderTimeline x) q' :> es
     , Group q, Group q', Commutative q, Commutative q'
     , Monoid q, Semigroup q
     , RQuery.Query q, RQuery.Query q'
     )
  => R.Dynamic (SpiderTimeline x) (QueryMorphism q q')
  -> Eff (Query (SpiderTimeline x) q : es) a
  -> Eff es a
dynWithQueryE fDyn inner = do
  r' <- askQueryResultE @(SpiderTimeline x) @q'
  (result, q') <- runQueryE @x @q
                    (R.zipDynWith RQuery.mapQueryResult fDyn r')
                    inner
  tellQueryIncrementalE @(SpiderTimeline x) @q' $
    zipDynIncrementalWith RQuery.mapQuery fDyn q'
  pure result
  where
    -- Verbatim port of the MTL zipDynIncrementalWith local helper. Used
    -- only inside dynWithQueryE; not exported. Applies a
    -- Dynamic-morphism to an Incremental with additive-patch semantics.
    zipDynIncrementalWith
      :: (QueryMorphism q q' -> q -> q')
      -> R.Dynamic (SpiderTimeline x) (QueryMorphism q q')
      -> R.Incremental (SpiderTimeline x) (AdditivePatch q)
      -> R.Incremental (SpiderTimeline x) (AdditivePatch q')
    zipDynIncrementalWith g da ib =
      let eab = Align.align (R.updated da) (R.updatedIncremental ib)
          ec = R.push
                 (\case
                    These.This a -> do
                      aOld <- R.sample (R.current da)
                      b    <- R.sample (R.currentIncremental ib)
                      pure (Just (AdditivePatch (g a b ~~ g aOld b)))
                    These.That (AdditivePatch b) -> do
                      a <- R.sample (R.current da)
                      pure (Just (AdditivePatch (g a b)))
                    These.These a (AdditivePatch b) -> do
                      aOld <- R.sample (R.current da)
                      bOld <- R.sample (R.currentIncremental ib)
                      pure (Just (AdditivePatch
                        (mconcat [ g a bOld, negateG (g aOld bOld), g a b ])))
                 )
                 eab
      in R.unsafeBuildIncremental
           (g <$> R.sample (R.current da) <*> R.sample (R.currentIncremental ib))
           ec

