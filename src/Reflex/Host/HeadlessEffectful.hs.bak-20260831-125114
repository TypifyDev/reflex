data Sample (t :: Type) :: Effect where
  Sample :: Behavior t a -> Sample t m a
type instance E.DispatchOf (Sample t) = E.Dynamic
sampleE :: Sample t :> es => Behavior t a -> Eff es a
sampleE b = send (Sample b)

data Hold (t :: Type) :: Effect where
  Hold             :: a -> R.Event t a -> Hold t m (Behavior t a)
  HoldDynE         :: a -> R.Event t a -> Hold t m (R.Dynamic t a)
  HoldIncrementalE :: Patch p => PatchTarget p -> R.Event t p -> Hold t m (R.Incremental t p)
  BuildDynamicE    :: PushM t a -> R.Event t a -> Hold t m (R.Dynamic t a)
  HeadEE           :: R.Event t a -> Hold t m (R.Event t a)
  NowE             :: Hold t m (R.Event t ())
type instance E.DispatchOf (Hold t) = E.Dynamic
holdE :: Hold t :> es => a -> R.Event t a -> Eff es (Behavior t a)
holdE a e = send (Hold a e)
holdDynE :: Hold t :> es => a -> R.Event t a -> Eff es (R.Dynamic t a)
holdDynE a e = send (HoldDynE a e)
holdIncrementalE :: (Hold t :> es, Patch p) => PatchTarget p -> R.Event t p -> Eff es (R.Incremental t p)
holdIncrementalE p e = send (HoldIncrementalE p e)
buildDynamicE :: Hold t :> es => PushM t a -> R.Event t a -> Eff es (R.Dynamic t a)
buildDynamicE p e = send (BuildDynamicE p e)
headEE :: Hold t :> es => R.Event t a -> Eff es (R.Event t a)
headEE e = send (HeadEE e)
nowE :: Hold t :> es => Eff es (R.Event t ())
nowE = send NowE

data NotReady (t :: Type) :: Effect where
  NotReady      :: NotReady t m ()
  NotReadyUntil :: R.Event t a -> NotReady t m ()
type instance E.DispatchOf (NotReady t) = E.Dynamic
notReadyE :: forall t es. NotReady t :> es => Eff es ()
notReadyE = send @(NotReady t) NotReady
notReadyUntilE :: forall t es a. NotReady t :> es => R.Event t a -> Eff es ()
notReadyUntilE e = send @(NotReady t) (NotReadyUntil e)

data SubscribeEvent (t :: Type) :: Effect where
  SubscribeEventOp :: RH.ReflexHost t => R.Event t a -> SubscribeEvent t m (EventHandle t a)
type instance E.DispatchOf (SubscribeEvent t) = E.Dynamic
subscribeEventE :: (SubscribeEvent t :> es, RH.ReflexHost t) => R.Event t a -> Eff es (EventHandle t a)
subscribeEventE e = send (SubscribeEventOp e)

data ReadEvent (t :: Type) :: Effect where
  ReadEventOp :: RH.ReflexHost t => EventHandle t a -> ReadEvent t m (Maybe (m a))
type instance E.DispatchOf (ReadEvent t) = E.Dynamic
readEventE :: forall t es a. (ReadEvent t :> es, RH.ReflexHost t) => EventHandle t a -> Eff es (Maybe (Eff es a))
readEventE h = send @(ReadEvent t) (ReadEventOp h)

data CreateTrigger (t :: Type) :: Effect where
  NewEventWithTrigger
    :: RH.ReflexHost t
    => (EventTrigger t a -> IO (IO ())) -> CreateTrigger t m (R.Event t a)
  NewFanEventWithTrigger
    :: (RH.ReflexHost t, GCompare k)
    => (forall a. k a -> EventTrigger t a -> IO (IO ()))
    -> CreateTrigger t m (EventSelector t k)
type instance E.DispatchOf (CreateTrigger t) = E.Dynamic
newEventWithTriggerE
  :: (CreateTrigger t :> es, RH.ReflexHost t)
  => (EventTrigger t a -> IO (IO ())) -> Eff es (R.Event t a)
newEventWithTriggerE f = send (NewEventWithTrigger f)
newFanEventWithTriggerE
  :: (CreateTrigger t :> es, RH.ReflexHost t, GCompare k)
