-- MTL class instances on 'EffectfulHost x' — DELETED as of the "no MTL
-- in host" cutover. Users write their guests using native effect
-- send-wrappers ('sampleE', 'holdE', 'subscribeEventE',
-- 'newEventWithTriggerE', 'readEventE', 'fireEventsAndReadE',
-- 'runHostFrameE', 'performEventE_', 'performEventE', 'getPostBuildE',
-- 'newTriggerEventE', 'notReadyE', 'runWithReplaceE') instead of
-- upstream MTL class methods. Upstream Reflex combinators that are
-- polymorphic over MTL classes ('foldDyn', 'switch', 'switchHold',
-- 'mergeMap', etc.) will not typecheck at @m ~ EffectfulHost x@ — port
-- them to native effect equivalents as needed.

-- 'MonadRef' — required by 'PerformEventT's 'newEventWithTriggerRef'.
-- Delegates to 'IORef' directly (matches upstream 'MonadRef (SpiderHost x)'
-- at Reflex/Spider/Internal.hs:2934).
instance MonadRef (EffectfulHost x) where
  type Ref (EffectfulHost x) = IORef
  newRef       = EffectfulHost . liftIO . newIORef
  readRef r    = EffectfulHost (liftIO (readIORef r))
  writeRef r a = EffectfulHost (liftIO (writeIORef r a))

instance MonadAtomicRef (EffectfulHost x) where
  atomicModifyRef r f = EffectfulHost (liftIO (atomicModifyIORef r f))

