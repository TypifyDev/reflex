runPerformEventAndAdjustable
  :: forall x es a.
     ( HasSpiderTimeline x
     , R.Reflex (SpiderTimeline x)
     , IOE :> es
     , Hold (SpiderTimeline x) :> es
     , Sample (SpiderTimeline x) :> es
     )
  => R.Event (SpiderTimeline x) (RequesterData Identity)
  -> Eff ( Adjustable (SpiderTimeline x)
         ': PerformEvent x
         ': Requester (SpiderTimeline x) (SI.SpiderHostFrame x) Identity
         ': es
         ) a
  -> Eff es (a, R.Event (SpiderTimeline x) (RequesterData (SI.SpiderHostFrame x)))
runPerformEventAndAdjustable responses act = do
  outerStateRef <- liftIO $ newIORef
    (RequesterState (-4) [] :: RequesterState (SpiderTimeline x) Any)
  let topLevelSel = R.fanInt
        (R.coerceEvent responses
          :: R.Event (SpiderTimeline x) (IntMap.IntMap Any))
  -- Cohort pointer: carries BOTH the current cohort's stateRef AND its
  -- per-cohort response selector. Per-cohort selectors are the mechanism
  -- that fixes nested-tag response routing (mirrors upstream
  -- 'runWithReplaceRequesterTWith' at
  -- vendor/reflex/src/Reflex/Requester/Base/Internal.hs:394-408 which
  -- passes 'selectInt responses' n' as each cohort's dedicated response
  -- event, un-nesting one level of RequesterData structure per
  -- 'runWithReplace' invocation). Previously carried only the stateRef —
  -- handlers used a single top-level 'selector' which could not see tags
  -- nested inside multi-entry bundled tags of enclosing cohorts.
  cohortPtr <- liftIO $ newIORef (outerStateRef, topLevelSel)
  result <-
      interpret (requesterHandler cohortPtr)
    . interpret (performEventHandler cohortPtr)
    . interpret (adjustableHandler cohortPtr)
    $ act
  -- Snapshot the OUTER state at the end of 'act'. Cohort bundled tag
  -- registrations (mirroring upstream 'requesting'') happen DURING outer
  -- build via the mdo/rec pattern in 'adjustableHandler', so those tags
  -- land in outerStateRef before this snapshot. When a cohort fires
  -- LATER (post-'act'), it writes to its own fresh stateRef; the outer's
  -- switchPromptlyDyn-fed aggregation event picks up the cohort's live
  -- fires through the bundled tag.
  s <- liftIO $ do
    s' <- readIORef outerStateRef
    System.IO.hPutStrLn System.IO.stderr $
      "[fixq] FUSED runner OUTER SNAPSHOT — "
        <> show (length (_requesterState_requests s')) <> " tag entries"
    System.IO.hFlush System.IO.stderr
    pure s'
  let aggEv = R.fmapCheap (RequesterData . TagMap) $
                R.mergeInt $ IntMap.fromDistinctAscList (_requesterState_requests s)
  pure (result, aggEv)
  where
    -- Allocate a request tag in whichever stateRef 'cohortPtr' currently
    -- points at. Shared IO helper used by both the PerformEvent handler
    -- (single-entry tags) and the cohort's bundled-event registration
    -- (multi-entry tag mirroring upstream 'requesting'').
    allocTag
      :: forall xtype. MyTagTypeOffset xtype
      => IORef ( IORef (RequesterState (SpiderTimeline x) Any)
               , R.EventSelectorInt (SpiderTimeline x) Any
               )
      -> R.Event (SpiderTimeline x) Any
      -> IO Int
    allocTag ptr ev = do
      (ref, _sel) <- readIORef ptr
      state <- readIORef ref
      let n = _requesterState_nextMyTag state
              .|. myTagTypeOffset (Proxy :: Proxy xtype)
      writeIORef ref $ state
        { _requesterState_nextMyTag = _requesterState_nextMyTag state - 4
        , _requesterState_requests  = (n, ev) : _requesterState_requests state
        }
      pure n

    -- IO-only cohort helper: run an IO action (typically 'unlift child')
    -- in a fresh Requester scope. Save current 'cohortPtr' target, swap
    -- to a fresh 'stateRef', run the child, restore. Return the child's
    -- result plus the cohort's aggregated 'Event' (snapshot at cohort
    -- exit). Both 'RunWithReplace' initial + replacement fires and
    -- 'TraverseIntMap' per-element + per-patch fires use this.
    runInCohortIO
      :: forall r. IORef ( IORef (RequesterState (SpiderTimeline x) Any)
                         , R.EventSelectorInt (SpiderTimeline x) Any
                         )
      -> R.EventSelectorInt (SpiderTimeline x) Any
      -> IO r
      -> IO (r, R.Event (SpiderTimeline x) (IntMap.IntMap Any))
    runInCohortIO cohortPtr cohortSel runChild = do
      System.IO.hPutStrLn System.IO.stderr "[fixq] runInCohortIO ENTER"
      System.IO.hFlush System.IO.stderr
      freshStateRef <- newIORef (RequesterState (-4) [])
      old <- readIORef cohortPtr
      writeIORef cohortPtr (freshStateRef, cohortSel)
      r <- runChild
      writeIORef cohortPtr old
      s <- readIORef freshStateRef
      let mergedEv = R.mergeInt $ IntMap.fromDistinctAscList
            (_requesterState_requests s)
      System.IO.hPutStrLn System.IO.stderr $
        "[fixq] runInCohortIO EXIT — cohort had "
          <> show (length (_requesterState_requests s)) <> " entries"
      System.IO.hFlush System.IO.stderr
      pure (r, mergedEv)

    -- Direct Requester handler: routes 'Requesting_' / 'Requesting' /
    -- 'RequestingBundled' to whichever stateRef 'cohortPtr' currently
    -- points at. Mirrors the outer 'runRequester' interpret handler
    -- (L744-783) but writes through the cohort indirection so cohort
    -- callers see their own tag namespace. All three constructors of
    -- the 'Requester' GADT are handled here so direct 'send @Requester'
    -- calls stay coherent with 'PerformEvent'-lifted writes.
    requesterHandler
      :: forall es'. IOE :> es'
      => IORef ( IORef (RequesterState (SpiderTimeline x) Any)
               , R.EventSelectorInt (SpiderTimeline x) Any
               )
      -> EffectHandler
           (Requester (SpiderTimeline x) (SI.SpiderHostFrame x) Identity)
           es'
    requesterHandler cohortPtr _ = \case
      Requesting evReqA -> do
        (n, sel) <- liftIO $ do
          let ev :: R.Event (SpiderTimeline x) Any
              ev = unsafeCoerce (R.fmapCheap singleEntry evReqA)
          n' <- allocTag @(Single Any) cohortPtr ev
          (_, s) <- readIORef cohortPtr
          pure (n', s)
        pure (unsafeCoerce (R.selectInt sel n))
      Requesting_ evReqA -> liftIO $ do
        let ev :: R.Event (SpiderTimeline x) Any
            ev = unsafeCoerce (R.fmapCheap singleEntry evReqA)
        _ <- allocTag @(Single Any) cohortPtr ev
        pure ()
      RequestingBundled bundleEv -> do
        (n, sel) <- liftIO $ do
          let ev :: R.Event (SpiderTimeline x) Any
              ev = unsafeCoerce bundleEv
          n' <- allocTag @Multi cohortPtr ev
          (_, s) <- readIORef cohortPtr
          pure (n', s)
        pure (unsafeCoerce (R.selectInt sel n))

    -- PerformEvent handler: routes 'PerformEventE_' / 'PerformEventE' to
    -- Requester writes via 'cohortPtr'. Fire-and-forget goes as
    -- 'Requesting_' (write, no response); response-carrying selects from
    -- the fanned response selector at the allocated tag.
    performEventHandler
      :: forall es'. IOE :> es'
      => IORef ( IORef (RequesterState (SpiderTimeline x) Any)
               , R.EventSelectorInt (SpiderTimeline x) Any
               )
      -> EffectHandler (PerformEvent x) es'
    performEventHandler cohortPtr _ = \case
      PerformEventE_ evAction -> liftIO $ do
        let ev :: R.Event (SpiderTimeline x) Any
            ev = unsafeCoerce (R.fmapCheap singleEntry evAction)
        _ <- allocTag @(Single Any) cohortPtr ev
        pure ()
      PerformEventE evAction -> do
        (n, sel) <- liftIO $ do
          let ev :: R.Event (SpiderTimeline x) Any
              ev = unsafeCoerce (R.fmapCheap singleEntry evAction)
          n' <- allocTag @(Single Any) cohortPtr ev
          (_, s) <- readIORef cohortPtr
          pure (n', s)
        pure (unsafeCoerce (R.selectInt sel n))

    -- Adjustable handler. 'RunWithReplace' implements per-cohort fresh
    -- Requester scope via the 'cohortPtr' swap + rec-tied bundled tag
    -- (mirrors upstream 'runWithReplaceRequesterTWith' at
    -- eff-reflex/Requester/Base.hs:402-408) AND inlines
    -- 'runAdjustable's Spider-native replacement mechanism (SpiderEvent
    -- + pushCheap + resultRef + drain-time 'performEventE') so this
    -- interpreter owns the full Adjustable + PerformEvent + Requester
    -- fusion — no 'Adjustable :> es' constraint required.
    --
    -- Traverse variants (TraverseIntMap*, TraverseDMap*, *WithMove)
    -- inline the same Spider replacement pattern as RunWithReplace but
    -- without cohort wrapping (MVP — the failing HydrationBrowser tests
    -- use 'runWithReplace' not traverse). Full-fidelity port would wrap
    -- each element via wrapCohort + mergeIncremental — a follow-up
    -- tracked as a sub-step of Task #122.
    adjustableHandler
      :: forall es'.
         ( IOE :> es'
         , PerformEvent x :> es'
         , Hold (SpiderTimeline x) :> es'
         , Sample (SpiderTimeline x) :> es'
         )
      => IORef ( IORef (RequesterState (SpiderTimeline x) Any)
               , R.EventSelectorInt (SpiderTimeline x) Any
               )
      -> EffectHandler (Adjustable (SpiderTimeline x)) es'
    adjustableHandler cohortPtr env = \case
      RunWithReplace a0 a' -> do
        na' <- R.numberOccurrencesFrom (1 :: Int) a'
        -- Read the CURRENT cohort's (parent's) stateRef+selector at handler
        -- entry. The bundled tag we register writes to parentStateRef (via
        -- 'allocTag cohortPtr'); the response for that tag is read via
        -- 'R.selectInt parentSel bundleTag'. This is the mechanism that
        -- lets nested runWithReplace's children propagate responses back
        -- through the parent scope without losing the tag-nesting
        -- information — mirrors upstream
        -- 'runWithReplaceRequesterTWith' at
        -- vendor/reflex/src/Reflex/Requester/Base/Internal.hs:394-408.
        (_parentStateRef, parentSel) <- liftIO $ readIORef cohortPtr
        rec let bundledEv :: R.Event (SpiderTimeline x) Any
                -- We skip 'multiEntry' (which needs 'IntMap (RequesterData f)')
                -- and 'unsafeCoerce' directly — at runtime 'RequesterData f',
                -- 'TagMap (Entry f)', and 'IntMap Any' are all newtype-
                -- equivalent representations. Same trick for the response
                -- side below.
                bundledEv = unsafeCoerce (RD.switchPromptlyDyn requestsDyn)
            -- Register bundled tag in parent's stateRef (allocTag writes
            -- to whatever cohortPtr currently points at — still parent's).
            bundleTag <- liftIO $ allocTag @Multi cohortPtr bundledEv
            -- Compute per-cohort response selector chain:
            --   parent response → unMultiEntry (implicit via unsafeCoerce)
            --   → fanInt over cohort indices (cohortLevelASel)
            --   → per-cohort N: fanInt over cohort N's individual tags
            -- This mirrors upstream Requester/Base/Internal.hs:404-406:
            --   responses <- fmap unMultiEntry $ requesting' $ ...
            --   let responses' = fanInt responses
            --   ... runRequesterT a $ selectInt responses' n ...
            -- and runRequesterT itself does 'fanInt $ coerceEvent responses'
            -- at line 316 to expose the cohort's own tags to child handlers.
            let cohortRespEv :: R.Event (SpiderTimeline x) (IntMap.IntMap Any)
                cohortRespEv = unsafeCoerce (R.selectInt parentSel bundleTag)
                cohortLevelASel :: R.EventSelectorInt (SpiderTimeline x) Any
                cohortLevelASel = R.fanInt cohortRespEv
                -- Per-cohort-N selector: another fanInt over cohort N's
                -- own response (which is an IntMap of individual tag payloads).
                mkCohortSel :: Int -> R.EventSelectorInt (SpiderTimeline x) Any
                mkCohortSel n =
                  R.fanInt (unsafeCoerce (R.selectInt cohortLevelASel n)
                             :: R.Event (SpiderTimeline x) (IntMap.IntMap Any))
                cohort0Sel :: R.EventSelectorInt (SpiderTimeline x) Any
                cohort0Sel = mkCohortSel 0
            liftIO $ do
              System.IO.hPutStrLn System.IO.stderr "[fixq] RunWithReplace handler ENTRY (outer build)"
              System.IO.hFlush System.IO.stderr
            (initial, triggerEv, resultRef) <-
              localUnliftIO env SeqForkUnlift $ \unlift -> do
                System.IO.hPutStrLn System.IO.stderr "[fixq] RunWithReplace localUnliftIO block ENTER"
                System.IO.hFlush System.IO.stderr
                -- Cohort 0 (a0's initial widget): install cohort0Sel while
                -- building a0. Any performEventE / Requesting from a0's
                -- descendants will 'R.selectInt cohort0Sel n' — which
                -- fires when responses come back via
                -- parentSel[bundleTag][0][n]. Nested runWithReplace
                -- inside a0 will further nest.
                initialResult <- runInCohortIO cohortPtr cohort0Sel (unlift a0)
                ref <- newIORef Nothing
                let triggerEv = SI.SpiderEvent $ SI.pushCheap
                      (\(n, newAction) -> do
                          liftIO $ do
                            System.IO.hPutStrLn System.IO.stderr $
                              "[fixq] pushCheap CALLBACK n=" <> show n <> " (fire time)"
                            System.IO.hFlush System.IO.stderr
                          -- Cohort N (replacement): compute its selector
                          -- at fire time (n only knowable from na' now).
                          let cohortNSel = mkCohortSel n
                          val <- liftIO (runInCohortIO cohortPtr cohortNSel (unlift newAction))
                          liftIO (writeIORef ref (Just (n, val)))
                          liftIO $ do
                            System.IO.hPutStrLn System.IO.stderr
                              "[fixq] pushCheap CALLBACK — wrote to resultRef, firing trigger"
                            System.IO.hFlush System.IO.stderr
                          pure (Just ()))
                      (SI.unSpiderEvent na')
                pure (initialResult, triggerEv, ref)
            v' <- performEventE @x $ R.fmapCheap
              (\() -> SI.SpiderHostFrame $ SI.EventM $ do
                  liftIO $ do
                    System.IO.hPutStrLn System.IO.stderr "[fixq] DRAIN lambda FIRED (next frame)"
                    System.IO.hFlush System.IO.stderr
                  mval <- readIORef resultRef
                  writeIORef resultRef Nothing
                  case mval of
                    Just val -> do
                      liftIO $ do
                        System.IO.hPutStrLn System.IO.stderr "[fixq] DRAIN found value, returning"
                        System.IO.hFlush System.IO.stderr
                      pure val
                    Nothing  -> error
                      "runPerformEventAndAdjustable/RunWithReplace: result IORef empty at drain (impossible)")
              triggerEv
            let (x0, req0) = initial
            requestsDyn <- holdDynE
              (R.fmapCheap (IntMap.singleton 0) req0)
              (R.fmapCheap
                (\(n, (_x, r)) -> R.fmapCheap (IntMap.singleton n) r)
                v')
        pure (x0, R.fmapCheap (fst . snd) v')
      -- Traverse variant cohort-scope status:
      --   * TraverseIntMap: FULL cohort scope. Each 'f k v' runs in a
      --     fresh Requester scope; per-element aggregated events are
      --     held incrementally and registered via a Multi3 tag on the
      --     outer state (mirrors upstream
      --     'traverseIntMapWithKeyWithAdjustRequesterTWith' at
      --     eff-reflex/Requester/Base.hs:435-475).
      --   * TraverseDMap: current impl inlines Spider replacement
      --     without cohort wrapping. Full port would add Multi2Contents
      --     + Dict + weakenDMapWith + mergeMap + Compose ((,) Int) for
      --     cohort-n threading, mirroring upstream L500-527. Task #122
      --     follow-up.
      --   * TraverseDMapWithMove: same limitation as TraverseDMap plus
      --     move semantics. Task #122 follow-up.
      --
      -- For the two remaining variants, any 'performEvent_' from a
      -- patch-fired child element writes to whatever 'cohortPtr' is
      -- currently set (typically outer, snapshotted) — same drop
      -- hazard TraverseIntMap and RunWithReplace now fix.
      TraverseIntMapWithKeyWithAdjustOp f m0 pev -> do
        -- Full port of upstream
        -- 'traverseIntMapWithKeyWithAdjustRequesterTWith' at
        -- vendor/reflex/src/Reflex/Requester/Base/Internal.hs:430-453.
        --
        -- Request structure (nested 2 deep, per upstream Multi3 unpack):
        --   Event (IntMap<k, IntMap<cohort_n, Any>>)
        -- Each element (k, n) — where n is the patch cohort that created
        -- the element at key k (0 for initial, numberOccurrencesFrom for
        -- patches) — emits `fmapCheap (IntMap.singleton n) mergedEv`.
        -- The outer incremental IntMap is keyed by k (element key).
        --
        -- Response un-nests symmetrically:
        --   parentSel[bundleTag] :: Event (IntMap<k, IntMap<n, Any>>)
        --   → fanInt by k = cohortLevelASel
        --   → for element (k, n):
        --       selectInt cohortLevelASel k :: Event (IntMap<n, Any>)
        --       mapMaybeCheap (IntMap.lookup n) :: Event Any (for THIS
        --                                                    specific cohort n)
        --       fanInt (unsafeCoerce ...) = per-tag selector for element (k,n)
        --
        -- Cohort n distinguishes re-inserts of same k across patches: an
        -- older element at key k in cohort 3 and a newer element at same k
        -- in cohort 5 are separate entities with independent response
        -- subscriptions. Mirrors upstream's Multi3 nesting exactly.
        (_, parentSel) <- liftIO $ readIORef cohortPtr
        -- Number patches: each PatchIntMap fire gets a fresh cohort n.
        -- Initial elements use n=0.
        numberedPev <- R.numberOccurrencesFrom (1 :: Int) pev
        rec let bundledEv :: R.Event (SpiderTimeline x) Any
                bundledEv = unsafeCoerce combinedEv
            bundleTag <- liftIO $ allocTag @Multi cohortPtr bundledEv
            let cohortRespEv :: R.Event (SpiderTimeline x) (IntMap.IntMap Any)
                cohortRespEv = unsafeCoerce (R.selectInt parentSel bundleTag)
                cohortLevelASel :: R.EventSelectorInt (SpiderTimeline x) Any
                cohortLevelASel = R.fanInt cohortRespEv
                -- Per-element (k, n) selector: fanned by k, filtered to
                -- cohort n, then fanned by individual tag. Mirrors upstream
                -- L440: 'mapMaybeCheap (IntMap.lookup n) $ selectInt responses k'.
                mkElementSel :: IntMap.Key -> Int -> R.EventSelectorInt (SpiderTimeline x) Any
                mkElementSel k n =
                  let perKeyEv :: R.Event (SpiderTimeline x) (IntMap.IntMap Any)
                      perKeyEv = unsafeCoerce (R.selectInt cohortLevelASel k)
                      perElementEv :: R.Event (SpiderTimeline x) Any
                      perElementEv = unsafeCoerce
                        (R.mapMaybeCheap (IntMap.lookup n) perKeyEv)
                      perElementIntMap :: R.Event (SpiderTimeline x) (IntMap.IntMap Any)
                      perElementIntMap = unsafeCoerce perElementEv
                  in R.fanInt perElementIntMap
            (initial, triggerEv, resultRef) <-
              localUnliftIO env SeqForkUnlift $ \unlift -> do
                -- Initial elements: cohort n=0 (mirrors upstream L443
                -- 'fmap ((,) 0) dm0'). Element (k, 0) uses mkElementSel k 0.
                pairsMap <- IntMap.traverseWithKey (\k v -> do
                  (v', mergedEv) <- runInCohortIO cohortPtr
                                      (mkElementSel k 0)
                                      (unlift (f k v))
                  pure (R.fmapCheap (IntMap.singleton 0) mergedEv, v')
                  ) m0
                ref <- newIORef Nothing
                let triggerEv = SI.SpiderEvent $ SI.pushCheap
                      (\(n, PatchIntMap patch) -> do
                          -- Each patch fires with a fresh cohort n.
                          -- Elements added by this patch use cohort n;
                          -- their events tagged (IntMap.singleton n).
                          -- Deletions (Nothing) propagate to the outer
                          -- PatchIntMap and prune from the incremental.
                          newInner <- liftIO $ IntMap.traverseWithKey
                            (\k mv -> case mv of
                              Nothing -> pure Nothing
                              Just v -> do
                                (v', mergedEv) <- runInCohortIO cohortPtr
                                                    (mkElementSel k n)
                                                    (unlift (f k v))
                                pure (Just ( R.fmapCheap (IntMap.singleton n)
                                               mergedEv
                                           , v')))
                            patch
                          liftIO (writeIORef ref (Just (PatchIntMap newInner)))
                          pure (Just ()))
                      (SI.unSpiderEvent numberedPev)
                pure (pairsMap, triggerEv, ref)
            drainedPatchEvent <- performEventE @x $ R.fmapCheap
              (\() -> SI.SpiderHostFrame $ SI.EventM $ do
                  mval <- readIORef resultRef
                  writeIORef resultRef Nothing
                  case mval of
                    Just val -> pure val
                    Nothing  -> error
                      "runPerformEventAndAdjustable/TraverseIntMap: result IORef empty at drain (impossible)")
              triggerEv
            let result0 :: IntMap.IntMap _
                result0 = fmap snd initial
                eventMap0 = fmap fst initial
                eventPatch = R.fmapCheap
                  (\(PatchIntMap p) -> PatchIntMap (fmap (fmap fst) p))
                  drainedPatchEvent
                result' = R.fmapCheap
                  (\(PatchIntMap p) -> PatchIntMap (fmap (fmap snd) p))
                  drainedPatchEvent
            -- Incremental IntMap<k, Event<IntMap<n, Any>>>. Overwrites on
            -- re-insert at same k (upstream semantics); Nothing prunes.
            requestsIncr <- holdIncrementalE eventMap0 eventPatch
            let mergedIncrEv = R.mergeIntIncremental requestsIncr
                promptRequests = R.coincidence $ R.fmapCheap
                  (\(PatchIntMap p) ->
                    R.mergeInt (IntMap.mapMaybe (fmap fst) p))
                  drainedPatchEvent
                combinedEv = R.mergeWith
                  (IntMap.unionWith IntMap.union)
                  [promptRequests, mergedIncrEv]
        pure (result0, result')
      TraverseDMapWithKeyWithAdjustOp @k f m0 pev -> do
        -- Full upstream-total port of
        -- 'traverseDMapWithKeyWithAdjustRequesterTWith' at
        -- vendor/reflex/src/Reflex/Requester/Base/Internal.hs:481-504.
        --
        -- Uses upstream's Multi2 tag + Multi2Contents packaging + fanMap
        -- for DMap-key-indexed selectors. Element identity is
        -- (Some k, cohort_n): keyed by 'Some k' via fanMap, filtered by
        -- cohort n via mapMaybeCheap (IntMap.lookup n). This matches
        -- upstream 1:1 modulo the effectful layer around it.
        --
        -- Structure:
        --   - Request bundling: mergeMapIncremental over PatchMap-indexed
        --     Incremental of per-element events. Packed as
        --     Entry (Multi2Contents { _multi2Contents_dict = Dict, ... }).
        --   - Response fan: fanMap the Multi2Contents-values Map, then
        --     select by (Const2 (Some k)), then mapMaybeCheap (IntMap.lookup n),
        --     then fanInt to get the element's per-tag selector.
        --   - Delete: PatchMap-Nothing at (Some k), prunes from incremental.
        (_, parentSel) <- liftIO $ readIORef cohortPtr
        numberedPev <- R.numberOccurrencesFrom (1 :: Int) pev
        rec let bundledEv :: R.Event (SpiderTimeline x) Any
                bundledEv = unsafeCoerce packedRequests
            bundleTag <- liftIO $ allocTag @(Multi2 k) cohortPtr bundledEv
            -- Response side: parent's response for bundleTag is
            -- Entry response (Multi2 k) = Multi2Contents k response.
            -- Extract _multi2Contents_values (Map (Some k) (IntMap Any))
            -- and fanMap to get per-key selector.
            let respAny :: R.Event (SpiderTimeline x) Any
                respAny = R.selectInt parentSel bundleTag
                respMap :: R.Event (SpiderTimeline x) (Map.Map (Some k) (IntMap.IntMap (IntMap.IntMap Any)))
                respMap = R.fmapCheap
                  (unsafeCoerce . _multi2Contents_values . unEntry . (unsafeCoerce :: Any -> Entry Any (Multi2 k)))
                  respAny
                respMapSel :: R.EventSelector (SpiderTimeline x) (Const2 (Some k) (IntMap.IntMap (IntMap.IntMap Any)))
                respMapSel = R.fanMap respMap
                mkElementSel :: Some k -> Int -> R.EventSelectorInt (SpiderTimeline x) Any
                mkElementSel sk n =
                  let perKeyEv :: R.Event (SpiderTimeline x) (IntMap.IntMap (IntMap.IntMap Any))
                      perKeyEv = R.select respMapSel (Const2 sk)
                      -- Filter to cohort n: IntMap n RequesterData → RequesterData (=IntMap tag Any)
                      perElementEv :: R.Event (SpiderTimeline x) (IntMap.IntMap Any)
                      perElementEv = R.mapMaybeCheap (IntMap.lookup n) perKeyEv
                  in R.fanInt perElementEv
            (m0', eventMap0, triggerEv, resultRef) <-
              localUnliftIO env SeqForkUnlift $ \unlift -> do
                initialAgg <- newIORef Map.empty
                -- Initial elements: cohort n=0.
                m0' <- DMap.traverseWithKey (\k v -> do
                    (r, mergedEv) <- runInCohortIO cohortPtr
                                       (mkElementSel (Some k) 0)
                                       (unlift (f k v))
                    liftIO $ modifyIORef' initialAgg
                      (Map.insert (Some k)
                        (R.fmapCheap (IntMap.singleton 0) mergedEv))
                    pure r
                  ) m0
                initialEventMap <- readIORef initialAgg
                ref <- newIORef Nothing
                let triggerEv = SI.SpiderEvent $ SI.pushCheap
                      (\(n, PatchDMap patch) -> do
                          -- Patch aggregator: Map (Some k) (Maybe event).
                          -- Just = insert/update; Nothing = delete.
                          patchAgg <- liftIO $ newIORef Map.empty
                          newInner <- liftIO $ DMap.traverseWithKey
                            (\k (ComposeMaybe mv) -> case mv of
                              Nothing -> do
                                modifyIORef' patchAgg
                                  (Map.insert (Some k) Nothing)
                                pure (ComposeMaybe Nothing)
                              Just v -> do
                                (r, mergedEv) <- runInCohortIO cohortPtr
                                                   (mkElementSel (Some k) n)
                                                   (unlift (f k v))
                                modifyIORef' patchAgg
                                  (Map.insert (Some k)
                                    (Just (R.fmapCheap (IntMap.singleton n) mergedEv)))
                                pure (ComposeMaybe (Just r)))
                            patch
                          patchEvents <- liftIO $ readIORef patchAgg
                          liftIO (writeIORef ref
                            (Just (PatchDMap newInner, PatchMap patchEvents)))
                          pure (Just ()))
                      (SI.unSpiderEvent numberedPev)
                pure (m0', initialEventMap, triggerEv, ref)
            drainedPatchEvent <- performEventE @x $ R.fmapCheap
              (\() -> SI.SpiderHostFrame $ SI.EventM $ do
                  mval <- readIORef resultRef
                  writeIORef resultRef Nothing
                  case mval of
                    Just val -> pure val
                    Nothing  -> error
                      "runPerformEventAndAdjustable/TraverseDMap: result IORef empty at drain (impossible)")
              triggerEv
            let dmapPatchEv = R.fmapCheap fst drainedPatchEvent
                eventPatchMap :: R.Event (SpiderTimeline x) (PatchMap (Some k) (R.Event (SpiderTimeline x) (IntMap.IntMap (IntMap.IntMap Any))))
                eventPatchMap = R.fmapCheap snd drainedPatchEvent
            requestsIncr <- holdIncrementalE eventMap0 eventPatchMap
            -- Aggregation + promptRequests + Multi2Contents wrapping
            -- (mirrors upstream Base/Internal.hs L501-504 exactly).
            let mergedMapEv = R.mergeMapIncremental requestsIncr
                promptRequests = R.coincidence $ R.fmapCheap
                  (\(PatchMap p) ->
                    R.mergeMap (Map.mapMaybe id p))
                  eventPatchMap
                combinedMapEv = R.mergeWith
                  (Map.unionWith (IntMap.unionWith IntMap.union))
                  [promptRequests, mergedMapEv]
                packedRequests :: R.Event (SpiderTimeline x) (Entry Any (Multi2 k))
                packedRequests = R.fmapCheap
                  (\m -> Entry (Multi2Contents
                                  { _multi2Contents_dict = Dict
                                  , _multi2Contents_values = unsafeCoerce m
                                  }))
                  combinedMapEv
        pure (m0', dmapPatchEv)
      TraverseDMapWithKeyWithAdjustWithMoveOp @k f m0 pev -> do
        -- Upstream-total port using Multi2 + fanMap + PatchMapWithMove.
        -- Same shape as TraverseDMap above with PatchDMapWithMove's
        -- three cases:
        --   * From_Insert v: run f in cohort scope, tag mergedEv w/cohort n.
        --   * From_Move src: emit a PatchMapWithMove From_Move on the
        --                    event aggregation too, so the element event
        --                    is retained under the new key. No new invocation
        --                    of f, no new cohort.
        --   * From_Delete: emit From_Delete on event aggregation to prune.
        (_, parentSel) <- liftIO $ readIORef cohortPtr
        numberedPev <- R.numberOccurrencesFrom (1 :: Int) pev
        rec let bundledEv :: R.Event (SpiderTimeline x) Any
                bundledEv = unsafeCoerce packedRequests
            bundleTag <- liftIO $ allocTag @(Multi2 k) cohortPtr bundledEv
            let respAny :: R.Event (SpiderTimeline x) Any
                respAny = R.selectInt parentSel bundleTag
                respMap :: R.Event (SpiderTimeline x) (Map.Map (Some k) (IntMap.IntMap (IntMap.IntMap Any)))
                respMap = R.fmapCheap
                  (unsafeCoerce . _multi2Contents_values . unEntry . (unsafeCoerce :: Any -> Entry Any (Multi2 k)))
                  respAny
                respMapSel :: R.EventSelector (SpiderTimeline x) (Const2 (Some k) (IntMap.IntMap (IntMap.IntMap Any)))
                respMapSel = R.fanMap respMap
                mkElementSel :: Some k -> Int -> R.EventSelectorInt (SpiderTimeline x) Any
                mkElementSel sk n =
                  let perKeyEv :: R.Event (SpiderTimeline x) (IntMap.IntMap (IntMap.IntMap Any))
                      perKeyEv = R.select respMapSel (Const2 sk)
                      -- Filter to cohort n: IntMap n RequesterData → RequesterData (=IntMap tag Any)
                      perElementEv :: R.Event (SpiderTimeline x) (IntMap.IntMap Any)
                      perElementEv = R.mapMaybeCheap (IntMap.lookup n) perKeyEv
                  in R.fanInt perElementEv
            (m0', eventMap0, triggerEv, resultRef) <-
              localUnliftIO env SeqForkUnlift $ \unlift -> do
                initialAgg <- newIORef Map.empty
                m0' <- DMap.traverseWithKey (\k v -> do
                    (r, mergedEv) <- runInCohortIO cohortPtr
                                       (mkElementSel (Some k) 0)
                                       (unlift (f k v))
                    liftIO $ modifyIORef' initialAgg
                      (Map.insert (Some k)
                        (R.fmapCheap (IntMap.singleton 0) mergedEv))
                    pure r
                  ) m0
                initialEventMap <- readIORef initialAgg
                ref <- newIORef Nothing
                let triggerEv = SI.SpiderEvent $ SI.pushCheap
                      (\(n, patchDMove@(PatchDMapWithMove patch)) -> do
                          patchAgg <- liftIO $ newIORef Map.empty
                          newInner <- liftIO $ DMap.traverseWithKey
                            (\k node -> do
                                newFrom <- case _nodeInfo_from node of
                                  From_Insert v -> do
                                    (r, mergedEv) <- runInCohortIO cohortPtr
                                                       (mkElementSel (Some k) n)
                                                       (unlift (f k v))
                                    modifyIORef' patchAgg
                                      (Map.insert (Some k)
                                        (PatchMapWithMove.NodeInfo
                                          { PatchMapWithMove._nodeInfo_from = PatchMapWithMove.From_Insert
                                              (R.fmapCheap (IntMap.singleton n) mergedEv)
                                          , PatchMapWithMove._nodeInfo_to = Nothing
                                          }))
                                    pure (From_Insert r)
                                  From_Delete -> do
                                    modifyIORef' patchAgg
                                      (Map.insert (Some k)
                                        (PatchMapWithMove.NodeInfo
                                          { PatchMapWithMove._nodeInfo_from = PatchMapWithMove.From_Delete
                                          , PatchMapWithMove._nodeInfo_to = Nothing
                                          }))
                                    pure From_Delete
                                  From_Move src -> do
                                    -- Move src → this k in the event map.
                                    -- PatchMapWithMove.From_Move records
                                    -- source key so the incremental relocates
                                    -- the existing event under the new key.
                                    modifyIORef' patchAgg
                                      (Map.insert (Some k)
                                        (PatchMapWithMove.NodeInfo
                                          { PatchMapWithMove._nodeInfo_from = PatchMapWithMove.From_Move (Some src)
                                          , PatchMapWithMove._nodeInfo_to = Nothing
                                          }))
                                    pure (From_Move src)
                                pure NodeInfo
                                  { _nodeInfo_from = newFrom
                                  , _nodeInfo_to   = _nodeInfo_to node
                                  })
                            patch
                          patchEvents <- liftIO $ readIORef patchAgg
                          liftIO (writeIORef ref
                            (Just ( PatchDMapWithMove newInner
                                  , PatchMapWithMove.unsafePatchMapWithMove patchEvents)))
                          pure (Just ()))
                      (SI.unSpiderEvent numberedPev)
                pure (m0', initialEventMap, triggerEv, ref)
            drainedPatchEvent <- performEventE @x $ R.fmapCheap
              (\() -> SI.SpiderHostFrame $ SI.EventM $ do
                  mval <- readIORef resultRef
                  writeIORef resultRef Nothing
                  case mval of
                    Just val -> pure val
                    Nothing  -> error
                      "runPerformEventAndAdjustable/TraverseDMapWithMove: result IORef empty at drain (impossible)")
              triggerEv
            let dmapPatchEv = R.fmapCheap fst drainedPatchEvent
                eventPatchMapWithMove :: R.Event (SpiderTimeline x) (PatchMapWithMove (Some k) (R.Event (SpiderTimeline x) (IntMap.IntMap (IntMap.IntMap Any))))
                eventPatchMapWithMove = R.fmapCheap snd drainedPatchEvent
            requestsIncr <- holdIncrementalE eventMap0 eventPatchMapWithMove
            let mergedMapEv = R.mergeMapIncrementalWithMove requestsIncr
                promptRequests = R.coincidence $ R.fmapCheap
                  (\patch ->
                    let patchMap = unPatchMapWithMove patch
                        insertsMap = Map.mapMaybe
                          (\ni -> case PatchMapWithMove._nodeInfo_from ni of
                            PatchMapWithMove.From_Insert e -> Just e
                            _ -> Nothing)
                          patchMap
                    in R.mergeMap insertsMap)
                  eventPatchMapWithMove
                combinedMapEv = R.mergeWith
                  (Map.unionWith (IntMap.unionWith IntMap.union))
                  [promptRequests, mergedMapEv]
                packedRequests :: R.Event (SpiderTimeline x) (Entry Any (Multi2 k))
                packedRequests = R.fmapCheap
                  (\m -> Entry (Multi2Contents
                                  { _multi2Contents_dict = Dict
                                  , _multi2Contents_values = unsafeCoerce m
                                  }))
                  combinedMapEv
        pure (m0', dmapPatchEv)

