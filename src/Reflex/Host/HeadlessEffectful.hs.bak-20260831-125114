-- Spider engine primitives — reproduced without SpiderHost
--
-- 'frame' is the IO-native version of Spider's 'runFrame' (byte-for-byte
-- port of the body at Reflex/Spider/Internal.hs:2375-2445), with two
-- changes:
--   (1) the outer 'SpiderHost $ ...' wrapper is removed — the body is
--       already IO;
--   (2) the recursive 'unSpiderHost $ runFrame $ ...' at the switch-
--       subscribe step becomes 'frame ...' (recursing to ourselves).
--
-- 'runE' is the IO-native version of Spider's 'run' (byte-for-byte port
-- of the body at Reflex/Spider/Internal.hs:1323-1354) with the same two
-- changes.
--
-- No SpiderHost mention anywhere.
--------------------------------------------------------------------------------

frame :: forall x a. HasSpiderTimeline x => EventM x a -> IO a
frame a = do
  let env = SI._spiderTimeline_eventEnv $ SI.unSTE (spiderTimeline :: SpiderTimelineEnv x)
  let go = do
        result <- a
        runHoldInits (SI.eventEnvHoldInits env) (SI.eventEnvDynInits env) (SI.eventEnvMergeInits env)
        return result
  result <- runEventM go
  toClear <- readIORef $ SI.eventEnvClears env
  forM_ toClear $ \(Some (SI.Clear ref)) -> writeIORef ref Nothing
  toClearInt <- readIORef $ SI.eventEnvIntClears env
  forM_ toClearInt $ \(Some (SI.IntClear ref)) -> writeIORef ref $! IntMap.empty
  toClearRoot <- readIORef $ SI.eventEnvRootClears env
  forM_ toClearRoot $ \(Some (SI.RootClear ref)) -> writeIORef ref $! DMap.empty
  toAssign <- readIORef $ SI.eventEnvAssignments env
  toReconnectRef <- newIORef []
  coincidenceInfos <- readIORef $ SI.eventEnvResetCoincidences env
  forM_ toAssign $ \(SI.SomeAssignment vRef iRef v) -> do
    writeIORef vRef v
    traceInvalidate $ "Invalidating Hold"
    writeIORef iRef =<< evaluate =<< invalidate toReconnectRef =<< readIORef iRef
  mergeUpdates <- readIORef $ SI.eventEnvMergeUpdates env
  writeIORef (SI.eventEnvMergeUpdates env) []
  tracePropagate (Proxy :: Proxy x) $ "Updating merges"
  mergeSubscriptionsToKill <- runEventM $ concat <$> mapM SI._someMergeUpdate_update mergeUpdates
  tracePropagate (Proxy :: Proxy x) $ "Updating merges done"
  toReconnect <- readIORef toReconnectRef
  clearEventEnv env
  switchSubscriptionsToKill <- forM toReconnect $ \(SI.SomeSwitchSubscribed subscribed) -> do
    oldSubscription <- readIORef $ SI.switchSubscribedCurrentParent subscribed
    wi <- readIORef $ SI.switchSubscribedOwnWeakInvalidator subscribed
    traceInvalidate $ "Finalizing invalidator for Switch"
    finalize wi
    i <- evaluate $ SI.switchSubscribedOwnInvalidator subscribed
    wi' <- mkWeakPtrWithDebug i "wi'"
    writeIORef (SI.switchSubscribedOwnWeakInvalidator subscribed) $! wi'
    writeIORef (SI.switchSubscribedBehaviorParents subscribed) []
    writeIORef (SI.eventEnvHoldInits env) []
    e <- runBehaviorM (readBehaviorTracked (SI.switchSubscribedParent subscribed))
                      (Just (wi', SI.switchSubscribedBehaviorParents subscribed))
                      (SI.eventEnvHoldInits env)
    runEventM $ runHoldInits (SI.eventEnvHoldInits env) (SI.eventEnvDynInits env) (SI.eventEnvMergeInits env)
    sub <- newSubscriberSwitch subscribed
    subscription <- frame (subscribe e sub)   -- recursive frame call, NOT runFrame
    writeIORef (SI.switchSubscribedCurrentParent subscribed) $! subscription
    return oldSubscription
  liftIO $ mapM_ unsubscribe mergeSubscriptionsToKill
  liftIO $ mapM_ unsubscribe switchSubscriptionsToKill
  forM_ toReconnect $ \(SI.SomeSwitchSubscribed subscribed) -> do
    SI.EventSubscription _ subd' <- readIORef $ SI.switchSubscribedCurrentParent subscribed
    parentHeight <- getEventSubscribedHeight subd'
    myHeight <- readIORef $ SI.switchSubscribedHeight subscribed
    when (parentHeight /= myHeight) $ do
      writeIORef (SI.switchSubscribedHeight subscribed) $! invalidHeight
      WeakBag.traverse_ (SI.switchSubscribedSubscribers subscribed) $ invalidateSubscriberHeight myHeight
  mapM_ SI._someMergeUpdate_invalidateHeight mergeUpdates
  forM_ coincidenceInfos $ \(SI.SomeResetCoincidence subscription mcs) -> do
    unsubscribe subscription
    mapM_ invalidateCoincidenceHeight mcs
  forM_ coincidenceInfos $ \(SI.SomeResetCoincidence _ mcs) -> mapM_ recalculateCoincidenceHeight mcs
  mapM_ SI._someMergeUpdate_recalculateHeight mergeUpdates
  forM_ toReconnect $ \(SI.SomeSwitchSubscribed subscribed) -> do
    height <- calculateSwitchHeight subscribed
    updateSwitchHeight height subscribed
  return result

-- | IO-native port of Spider's 'run'. Body verbatim from
-- Reflex/Spider/Internal.hs:1323-1354; the outer 'SpiderHost $ ...' at
-- the withMVar step becomes plain 'do', and the recursive
-- 'unSpiderHost $ runFrame $ ...' becomes 'frame'.
runE
  :: forall x b
   . HasSpiderTimeline x
  => [DSum (RootTrigger x) Identity] -> ResultM x b -> IO b
runE roots after = do
  tracePropagate (Proxy :: Proxy x) $ "Running an event frame with " <> show (length roots) <> " events"
  let t = spiderTimeline :: SpiderTimelineEnv x
  result <- withMVar (SI._spiderTimeline_lock (SI.unSTE t)) $ \_ -> frame $ do
    rootsToPropagate <- forM roots $ \r@(RootTrigger (_, occRef, k) :=> a) -> do
      occBefore <- liftIO $ do
        occBefore <- readIORef occRef
        writeIORef occRef $! DMap.insert k a occBefore
        return occBefore
      if DMap.null occBefore
        then do scheduleRootClear occRef
                return $ Just r
        else return Nothing
    forM_ (catMaybes rootsToPropagate) $ \(RootTrigger (subscribersRef, _, _) :=> Identity a) -> do
      propagate a subscribersRef
    delayedRef <- asksEventEnv SI.eventEnvDelayedMerges
    let go = do
          delayed <- liftIO $ readIORef delayedRef
          case IntMap.minViewWithKey delayed of
            Nothing -> return ()
            Just ((currentHeight, cur), future) -> do
              tracePropagate (Proxy :: Proxy x) $ "Running height " ++ show currentHeight
              putCurrentHeight $ Height currentHeight
              liftIO $ writeIORef delayedRef $! future
              sequence_ cur
              go
    go
    putCurrentHeight maxBound
    after
  tracePropagate (Proxy :: Proxy x) "Done running an event frame"
  return result

